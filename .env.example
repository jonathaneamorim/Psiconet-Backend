# Copie para .env e preencha. NUNCA versione o .env nem coloque valores reais aqui.

# --- Banco de dados (container Postgres) ---
POSTGRES_USER=psiconet_db
POSTGRES_PASSWORD=
POSTGRES_DB=psiconet

# --- Aplicação Spring ---
# URL/usuário/senha do banco usados pela API (a senha cai para POSTGRES_PASSWORD se vazia)
DB_URL=jdbc:postgresql://localhost:5432/psiconet
DB_USERNAME=psiconet_db
DB_PASSWORD=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- pgAdmin (apenas desenvolvimento local) ---
PGADMIN_EMAIL=admin@psiconet.com
PGADMIN_PASSWORD=

# --- JWT ---
# Segredo HMAC com no mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
APP_JWT_EXPIRATION_MS=3600000
